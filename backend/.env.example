# Ambiente (development | production)
ENVIRONMENT=development

# Projeto GCP & Firestore
GCP_PROJECT_ID=seu-projeto-gcp
FIRESTORE_DATABASE=(default)

# Household Compartilhado
HOUSEHOLD_ID=rock-family

# Controle de Acesso por Email (separados por vírgula)
ALLOWED_USER_EMAILS=user1@example.com,user2@example.com
# UIDs do Firebase Auth (Console > Authentication > Users > "User UID"), 1 ou 2, separados por vírgula
ALLOWED_USER_UIDS=uid-usuario-1,uid-usuario-2

# Configuração de CORS (separados por vírgula)
APP_ORIGINS=http://localhost:8080,https://seu-dominio-cloud-run.a.run.app

# Firebase Auth - Configuração Pública Web (utilizada pelo frontend)
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=seu-projeto-gcp.firebaseapp.com
FIREBASE_PROJECT_ID=seu-projeto-gcp
FIREBASE_APP_ID=1:1234567890:web:abcdef

# Bypass de Autenticação para Dev Local (NUNCA usar em produção - deve estar false por padrão)
AUTH_DEV_BYPASS=false

# IA via Vertex AI (sem API key). Local: gcloud auth application-default login
VERTEX_LOCATION=global

# IA (desligada por padrão para não gerar custo)
AI_ENABLED=false
AI_DAILY_LIMIT=20
GEMINI_MODEL=gemini-3-flash-preview
